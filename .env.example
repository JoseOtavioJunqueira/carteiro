# Copy to .env and change for anything beyond a local demo. .env is git-ignored.
POSTGRES_PASSWORD=carteiro
CARTEIRO_API_KEY=dev-api-key
# Must match the "secret" you register the demo endpoint with.
RECEIVER_SECRET=whsec_demo_secret_change_me
# Host ports, if 8080/8081 are already taken on your machine.
CARTEIRO_PORT=8080
RECEIVER_PORT=8081
