{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Carteiro": ""
  },
  "Carteiro": {
    "ApiKeys": [],
    "Database": {
      "MigrateOnStartup": false
    },
    "Delivery": {
      "MaxAttempts": 10,
      "BaseDelay": "00:00:10",
      "MaxDelay": "01:00:00",
      "RequestTimeout": "00:00:10",
      "AllowPrivateNetworks": false,
      "EndpointFailureThreshold": 20
    },
    "Worker": {
      "Enabled": true,
      "PollInterval": "00:00:01",
      "BatchSize": 20,
      "ClaimLease": "00:01:00"
    }
  }
}
